# General Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
# For local MongoDB: mongodb://127.0.0.1:27017/careerconnect
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/careerconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/careerconnect

# Authentication Configuration
JWT_SECRET=careerconnect_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRE=30d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Socket.IO Configuration
VITE_SOCKET_URL=http://localhost:5000
